{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataOps Studio",
  "version": "2.0.1",
  "identifier": "com.dataops.studio.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DataOps Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Local data operations workbench",
    "longDescription": "DataOps Studio local data operations workbench with an offline Python and PostgreSQL runtime."
  }
}
